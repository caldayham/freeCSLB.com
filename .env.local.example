# ===== Supabase =====
# From your Supabase project: Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (new format, replaces anon key). Client-safe, RLS-protected.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (new format, replaces service_role). Server-only. Never commit. Never expose to browser.
SUPABASE_SECRET_KEY=sb_secret_...

# ===== Site =====
# Base URL used for magic-link redirects. Leave unset locally to use the browser origin;
# set to the production domain in the production environment.
NEXT_PUBLIC_SITE_URL=https://freecslb.com

# ===== Anthropic =====
# For Opus (planner, post-mortem) + Sonnet (verification, generation)
ANTHROPIC_API_KEY=sk-ant-...
